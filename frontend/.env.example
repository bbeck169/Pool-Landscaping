# Frontend environment. Copy to .env and fill in.

# Backend base URL (must not have a trailing slash)
REACT_APP_BACKEND_URL=https://your-app.preview.emergentagent.com

# Google Maps + Places (Autocomplete + Maps tiles)
REACT_APP_GOOGLE_API_KEY=

# Watchers off in containerized dev environments (CRA quirk)
WDS_SOCKET_PORT=443
