s array to be: [customerId, load, registerOpener]",{"range":"4959","text":"4960"},"Update the dependencies array to be: [customerId, loadPage]",{"range":"4961","text":"4962"},"Update the dependencies array to be: [open, selectedIds]",{"range":"4963","text":"4964"},"Update the dependencies array to be: [primaryId, open, selectedIds]",{"range":"4965","text":"4966"},"Update the dependencies array to be: [custom, emit, preset]",{"range":"4967","text":"4968"},"Update the dependencies array to be: [preset, custom, effectiveTz, emit]",{"range":"4969","text":"4970"},"Update the dependencies array to be: [activeRange.start, activeRange.end, activeTab, activeRange]",{"range":"4971","text":"4972"},"Update the dependencies array to be: [center, onCameraChanged, zoom]",{"range":"4973","text":"4974"},"Update the dependencies array to be: [map, H, position.lat, position.lng, position, children, onClick]",{"range":"4975","text":"4976"},"Update the dependencies array to be: [map, H, position.lat, position.lng, position, children, onCloseClick]",{"range":"4977","text":"4978"},"Update the dependencies array to be: [map, H, strokeColor, lineWidth, path]",{"range":"4979","text":"4980"},"Update the dependencies array to be: [filters]",{"range":"4981","text":"4982"},{"range":"4983","text":"4982"},"Update the dependencies array to be: [qs, state.rows]",{"range":"4984","text":"4985"},"Update the dependencies array to be: [buCategoryId, incomeCategories, isRevenueVariant, resolveInitialBuId]",{"range":"4986","text":"4987"},"Update the dependencies array to be: [url, reloadKey, cursor]",{"range":"4988","text":"4989"},"Update the dependencies array to be: [signature, sequenceId, canPreview, payload]",{"range":"4990","text":"4991"},"Update the dependencies array to be: [open, debChannels, debSubj, debBody, debTpl, useCustom, debCats, debDays, debTechs, audienceStatus, chList, templateId, categoryIds, serviceDays, assignedTechUserIds]",{"range":"4992","text":"4993"},"Update the dependencies array to be: [categories, data, format, onBarClick, testid]",{"range":"4994","text":"4995"},[6004,6026],"[user, user.id, user.role]",[5395,5413],"[enabled, authKey, refetch]",[4269,4271],"[flushSave]",[1830,1837],"[load, month]",[1281,1289],"[load, period]",[1543,1556],"[days, limit, load]",[15391,15393],"[load]",[16069,16080],"[load, searchParams, setSearchParams, statusTab]",[18314,18316],"[_loadCategories]",[22402,22435],"[modalOpen, editing.customer_id, editing]",[5352,5361],"[enabled, startWS, teardown]",[4143,4232],"[title, externalUrl, sortOrder, description, icon, isActive, editing, initial.id, onSaved]",[34558,34560],[2024,2099],"[profitMode, profitPct, opexCents, profitDollarsCents]",[2016,2022],"[load, year]",[3145,3153],"[load, status]",[24862,24870],"[filter, load]",[28282,28290],[3643,3666],"[today, openInAt]",[8765,8773],[10842,10858],"[isLoaded, data, legMap]",[11801,11815],"[yFor, nowIso]",[9974,9984],"[lead?.id, loadCommunications]",[2362,2370],"[formId, key]",[8080,8107],"[activeTab, filters.status, refresh]",[2103,2112],"[filters, load]",[15872,15886],"[techId, date, load]",[21718,21732],"[_mergeParams, can, navigate, params, rows]",[62881,62893],"[target, target.id]",[69594,69606],[9087,9102],"[filters, load, page]",[24403,24412],[33056,33071],"[filters, page, searchParams, setSearchParams]",[23632,23634],"[center, onClickMap]",[7883,7887],"[id, load]",[3403,3428],"[kindFilters, searchParams, setSearchParams, unreadOnly]",[14998,15006],[29024,29026],"[form]",[32179,32190],"[zip, days, load]",[21554,21556],"[form, schedule]",[27759,27761],"[ai]",[17591,17595],[26445,26476],"[filter.status, filter.channel, load]",[2709,2726],"[status, channel, load]",[32060,32064],[4101,4112],"[map, mode, onDrawn, resetPreview]",[1222,1224],"[bankId]",[3446,3453],"[loadList, state]",[3330,3332],"[techId]",[10166,10170],[1338,1355],"[auditId, filter, load]",[1379,1387],[8020,8024],[13439,13465],"[techId, day, unschedJobs, previewsById]",[2190,2192],[10818,10824],"[days, load]",[5684,5714],"[current.status, current.id, current]",[9281,9285],[9589,9604],"[audit, audit.status, load]",[3205,3219],"[selected, selected.id]",[2587,2589],"[selectedId]",[1679,1681],"[ctxUser]",[5058,5101],"[dimension, rangeKey, customFrom, customTo, isAdmin, load]",[14682,14693],"[draft, draft.id]",[1196,1198],"[loadHistory, url]",[2984,2998],"[load, showInactive]",[11236,11238],[10672,10674],[2451,2460],"[feature, loadTxns]",[2591,2608],"[token, user, user.id]",[30792,30805],"[jobId, jobs, techId]",[2010,2024],"[loadList, statusFilter]",[7337,7354],"[params, allowed, load]",[1493,1501],"[load, window]",[10295,10324],"[row.body, row.subject, id, row]",[2017,2027],"[loadHistory, user.id]",[6465,6482],"[includeArchived, load]",[6222,6239],[2264,2266],"[limit, personaKey, since, toolName]",[17976,17980],[7608,7654],"[customerFilter, loadRows]",[13002,13006],[13352,13373],"[doc, doc.id, doc.terms]",[1688,1690],"[actorEmail, since, until]",[10055,10067],"[_now, _stop, _today, id, isEdit, patch]",[37423,37429],"[date, load]",[37668,37676],"[crewId, load]",[37982,37990],"[load, techId]",[39091,39093],[42045,42076],"[techs, techId, _techFilterKey, setParam]",[51573,51590],"[load, rescheduleDraft]",[9963,9995],"[form.crew_id, crews, techDirty, form.technician_id]",[6953,6957],[1739,1743],[16094,16096],"[searchParams, tab]",[21178,21182],[24594,24596],[26015,31957],"useCallback(async () => {\n    setRows(null);\n    const params = new URLSearchParams();\n    if (searchDeb) params.set(\"search\", searchDeb);\n    if (tag) params.set(\"tag\", tag);\n    if (scope === \"waitlist\") params.set(\"waitlisted\", \"true\");\n    if (scope === \"unscheduled\") params.set(\"unscheduled\", \"true\");\n    if (tab === \"active\") params.set(\"is_active\", \"true\");\n    else if (tab === \"inactive\") params.set(\"is_active\", \"false\");\n    else if (tab === \"muted\") params.set(\"is_muted\", \"true\");\n    // Phase H4 · Feb-2026 — Waitlist cohort tab. Sends the backend\n    // ``?waitlisted=true`` predicate (canonical ``customers.waitlisted``\n    // field toggled by the Add/Remove-from-waitlist bulk actions).\n    // Waitlist is orthogonal to active/inactive/muted — those filters\n    // are intentionally omitted so a waitlisted-and-muted row still\n    // shows here. Stacks as intersection with the G4a portal filter.\n    else if (tab === \"waitlist\") params.set(\"waitlisted\", \"true\");\n    if (missingCardOnly) params.set(\"missing_card\", \"true\");\n    // Phase G4a · Feb-2026 — Portal-activation filter. Only send the\n    // param when the operator has selected a non-default value so\n    // the wire log stays clean and the backend never sees ``all``\n    // (harmless no-op today but explicit intent > accidental\n    // dependence on the server-side alias).\n    if (portalStatus && portalStatus !== \"all\") {\n      params.set(\"portal_status\", portalStatus);\n    }\n    // Feb-2026 · P43 — data-quality filters.\n    if (missingEmail) params.set(\"missing_email\", \"true\");\n    if (missingPhone) params.set(\"missing_phone\", \"true\");\n    if (missingAddress) params.set(\"missing_address\", \"true\");\n    // Feb-2026 · P43c — Portal status tri-state.\n    if (portalStatusFilter === \"activated\") params.set(\"portal_activated\", \"true\");\n    else if (portalStatusFilter === \"not_activated\") params.set(\"portal_activated\", \"false\");\n    // Feb-2026 · P44 — \"No payment on file\" chip.\n    if (noPaymentFilter) params.set(\"has_payment_method\", \"false\");\n    // Feb-2026 · Tail Fix D — Cards-on-file tile inbound filter.\n    // Mutex-guarded: never fires simultaneously with ``noPaymentFilter``\n    // (state-level mutex enforced in the toggle/hydration paths + URL\n    // sync effect below). Emits the canonical ``true`` payload the\n    // backend already accepts (see ``routers/customers.py`` L816 /\n    // L1212–1224 — filter uses the ``saved_payment_methods_count``\n    // denorm, same join semantic the tile counts against).\n    else if (hasCardFilter) params.set(\"has_payment_method\", \"true\");\n    // Feb-2026 · Customer temp password + first-access — \"Never\n    // logged in\" chip. Distinct filter from portal_activated.\n    if (neverLoggedIn) params.set(\"first_access\", \"never\");\n    // Feb-2026 · Onboarding-tile clickable ship — sibling\n    // Invited / Signed-in chips. Mutual exclusion with\n    // ``never`` on the shared ``first_access`` param is enforced\n    // by the toggle handlers below; here we just pass the state\n    // through so the backend sees the intended predicate.\n    else if (signedInFilter) params.set(\"first_access\", \"any\");\n    if (portalInvitedFilter) params.set(\"portal_invited\", \"any\");\n    // Feb-2026 · P46 — city + multi-tag now flow through the backend\n    // so pagination + tab counts stay honest. Repeat the ``tags``\n    // key per selected value so backend gets a proper list.\n    if (city && city.trim()) params.set(\"city\", city.trim());\n    for (const t of selectedTags) params.append(\"tags\", t);\n    // Feb-2026 · P26 — admin-tier escape hatch (widened by the\n    // Customer Delete UX overhaul) to see soft-deleted rows.\n    if (includeDeleted && canManageDeleted) params.set(\"include_deleted\", \"true\");\n    // Feb 2026 · Customer Merge Phase 2 — surface merged rows when\n    // \"Show merged\" is on. Backend default is false, so a merged\n    // customer normally disappears from the list post-merge.\n    if (includeMerged) params.set(\"include_merged\", \"true\");\n    // Feb-2026 · P35 — always request the paginated envelope.\n    params.set(\"page\", String(page));\n    params.set(\"page_size\", String(pageSize));\n    // Feb 2026 · Sort dropdown — passthrough. Backend defaults to\n    // ``created_desc`` when omitted (same default as the UI) so\n    // this line is defensive but strictly clarifies intent on the\n    // wire log.\n    if (sortBy) params.set(\"sort\", sortBy);\n    try {\n      const data = await api.get(`/customers?${params.toString()}`);\n      // Envelope-shaped when page/page_size present (Strategy B).\n      const items = Array.isArray(data) ? data : (data?.items || []);\n      setRows(items);\n      setTotal(Number.isFinite(data?.total) ? data.total : items.length);\n      setTotalPages(Number.isFinite(data?.total_pages)\n        ? data.total_pages\n        : (items.length ? 1 : 0));\n      // Phase K68 · Feb-2026 — consume the paginated envelope's\n      // ``counts_by_status`` block so the tab badges refresh in a\n      // single round-trip. Falls back to the legacy separate-fanout\n      // in ``loadCounts()`` when the server doesn't ship the block\n      // (e.g. stale API). Non-admin users only see ``active`` — we\n      // still overwrite for correctness (admin-only tabs are hidden\n      // upstream, so writing them is harmless).\n      const cbs = data?.counts_by_status;\n      if (cbs && typeof cbs === \"object\") {\n        setCounts({\n          active: Number.isFinite(cbs.active) ? cbs.active : 0,\n          inactive: Number.isFinite(cbs.inactive) ? cbs.inactive : 0,\n          muted: isAdmin && Number.isFinite(cbs.muted) ? cbs.muted : null,\n          waitlist: isAdmin && Number.isFinite(cbs.waitlist)\n            ? cbs.waitlist : null,\n          all: isAdmin && Number.isFinite(cbs.all) ? cbs.all : null,\n        });\n      }\n      setSelected(new Set());\n    } catch (e) {\n      setToast({ tone: \"error\", message: e.message });\n      setRows([]);\n      setTotal(0);\n      setTotalPages(0);\n    }\n  })",[24418,24427],"[isAdmin, tab]",[25991,25996],"[cohortParam, navigate, searchParams, setSearchParams, tab]",[36882,37171],"[searchDeb, tag, scope, tab, missingCardOnly, missingEmail, missingPhone, missingAddress, portalStatusFilter, noPaymentFilter, hasCardFilter, neverLoggedIn, portalInvitedFilter, signedInFilter, includeDeleted, includeMerged, page, pageSize, city, selectedTags, sortBy, portalStatus, load, loadCounts]",[3