nnelId, createPeer, flushRecordingToClip, getUserMediaFn, startRecording, stopVox, teardownPeer, tokenGetter, user?.id]",{"range":"4493","text":"4494"},"Update the dependencies array to be: [connectedRowInKeys, schemas.sms]",{"range":"4495","text":"4496"},"Update the dependencies array to be: [connectedRowInKeys, schemas.email]",{"range":"4497","text":"4498"},"Update the dependencies array to be: [nonSecretFields, usage, usage.monthly_request_cap]",{"range":"4499","text":"4500"},"Update the dependencies array to be: [selectedTech, technicians, technicians.length]",{"range":"4501","text":"4502"},"Update the dependencies array to be: [readingsDict, locked, fetchRecommendations]",{"range":"4503","text":"4504"},"Update the dependencies array to be: [center, onCameraChanged, zoom]",{"range":"4505","text":"4506"},"Update the dependencies array to be: [map, H, position.lat, position.lng, position, children, onClick]",{"range":"4507","text":"4508"},"Update the dependencies array to be: [map, H, position.lat, position.lng, position, children, onCloseClick]",{"range":"4509","text":"4510"},"Update the dependencies array to be: [map, H, strokeColor, lineWidth, path]",{"range":"4511","text":"4512"},"Update the dependencies array to be: [buCategoryId, incomeCategories, isRevenueVariant, resolveInitialBuId]",{"range":"4513","text":"4514"},"Update the dependencies array to be: [url, reloadKey, cursor]",{"range":"4515","text":"4516"},"Update the dependencies array to be: [open, debChannels, debSubj, debBody, debTpl, useCustom, debCats, debDays, debTechs, audienceStatus, chList, templateId, categoryIds, serviceDays, assignedTechUserIds]",{"range":"4517","text":"4518"},"Update the dependencies array to be: [signature, sequenceId, canPreview, payload]",{"range":"4519","text":"4520"},"Update the dependencies array to be: [load, open, q, tagFilter]",{"range":"4521","text":"4522"},"Update the dependencies array to be: [filters]",{"range":"4523","text":"4524"},{"range":"4525","text":"4524"},"Update the dependencies array to be: [qs, state.rows]",{"range":"4526","text":"4527"},"Update the dependencies array to be: [categories, data, format, onBarClick, testid]",{"range":"4528","text":"4529"},[6004,6026],"[user, user.id, user.role]",[5395,5413],"[enabled, authKey, refetch]",[2591,2608],"[token, user, user.id]",[2017,2027],"[loadHistory, user.id]",[1688,1690],"[actorEmail, since, until]",[2264,2266],"[limit, personaKey, since, toolName]",[1739,1743],"[id, load]",[9749,9751],"[searchParams, tab]",[13300,13304],[23849,29246],"useCallback(async () => {\n    setRows(null);\n    const params = new URLSearchParams();\n    if (searchDeb) params.set(\"search\", searchDeb);\n    if (tag) params.set(\"tag\", tag);\n    if (scope === \"waitlist\") params.set(\"waitlisted\", \"true\");\n    if (scope === \"unscheduled\") params.set(\"unscheduled\", \"true\");\n    if (tab === \"active\") params.set(\"is_active\", \"true\");\n    else if (tab === \"inactive\") params.set(\"is_active\", \"false\");\n    else if (tab === \"muted\") params.set(\"is_muted\", \"true\");\n    // Phase H4 · Feb-2026 — Waitlist cohort tab. Sends the backend\n    // ``?waitlisted=true`` predicate (canonical ``customers.waitlisted``\n    // field toggled by the Add/Remove-from-waitlist bulk actions).\n    // Waitlist is orthogonal to active/inactive/muted — those filters\n    // are intentionally omitted so a waitlisted-and-muted row still\n    // shows here. Stacks as intersection with the G4a portal filter.\n    else if (tab === \"waitlist\") params.set(\"waitlisted\", \"true\");\n    if (missingCardOnly) params.set(\"missing_card\", \"true\");\n    // Phase G4a · Feb-2026 — Portal-activation filter. Only send the\n    // param when the operator has selected a non-default value so\n    // the wire log stays clean and the backend never sees ``all``\n    // (harmless no-op today but explicit intent > accidental\n    // dependence on the server-side alias).\n    if (portalStatus && portalStatus !== \"all\") {\n      params.set(\"portal_status\", portalStatus);\n    }\n    // Feb-2026 · P43 — data-quality filters.\n    if (missingEmail) params.set(\"missing_email\", \"true\");\n    if (missingPhone) params.set(\"missing_phone\", \"true\");\n    if (missingAddress) params.set(\"missing_address\", \"true\");\n    // Feb-2026 · P43c — Portal status tri-state.\n    if (portalStatusFilter === \"activated\") params.set(\"portal_activated\", \"true\");\n    else if (portalStatusFilter === \"not_activated\") params.set(\"portal_activated\", \"false\");\n    // Feb-2026 · P44 — \"No payment on file\" chip.\n    if (noPaymentFilter) params.set(\"has_payment_method\", \"false\");\n    // Feb-2026 · Customer temp password + first-access — \"Never\n    // logged in\" chip. Distinct filter from portal_activated.\n    if (neverLoggedIn) params.set(\"first_access\", \"never\");\n    // Feb-2026 · Onboarding-tile clickable ship — sibling\n    // Invited / Signed-in chips. Mutual exclusion with\n    // ``never`` on the shared ``first_access`` param is enforced\n    // by the toggle handlers below; here we just pass the state\n    // through so the backend sees the intended predicate.\n    else if (signedInFilter) params.set(\"first_access\", \"any\");\n    if (portalInvitedFilter) params.set(\"portal_invited\", \"any\");\n    // Feb-2026 · P46 — city + multi-tag now flow through the backend\n    // so pagination + tab counts stay honest. Repeat the ``tags``\n    // key per selected value so backend gets a proper list.\n    if (city && city.trim()) params.set(\"city\", city.trim());\n    for (const t of selectedTags) params.append(\"tags\", t);\n    // Feb-2026 · P26 — admin-tier escape hatch (widened by the\n    // Customer Delete UX overhaul) to see soft-deleted rows.\n    if (includeDeleted && canManageDeleted) params.set(\"include_deleted\", \"true\");\n    // Feb 2026 · Customer Merge Phase 2 — surface merged rows when\n    // \"Show merged\" is on. Backend default is false, so a merged\n    // customer normally disappears from the list post-merge.\n    if (includeMerged) params.set(\"include_merged\", \"true\");\n    // Feb-2026 · P35 — always request the paginated envelope.\n    params.set(\"page\", String(page));\n    params.set(\"page_size\", String(pageSize));\n    // Feb 2026 · Sort dropdown — passthrough. Backend defaults to\n    // ``created_desc`` when omitted (same default as the UI) so\n    // this line is defensive but strictly clarifies intent on the\n    // wire log.\n    if (sortBy) params.set(\"sort\", sortBy);\n    try {\n      const data = await api.get(`/customers?${params.toString()}`);\n      // Envelope-shaped when page/page_size present (Strategy B).\n      const items = Array.isArray(data) ? data : (data?.items || []);\n      setRows(items);\n      setTotal(Number.isFinite(data?.total) ? data.total : items.length);\n      setTotalPages(Number.isFinite(data?.total_pages)\n        ? data.total_pages\n        : (items.length ? 1 : 0));\n      // Phase K68 · Feb-2026 — consume the paginated envelope's\n      // ``counts_by_status`` block so the tab badges refresh in a\n      // single round-trip. Falls back to the legacy separate-fanout\n      // in ``loadCounts()`` when the server doesn't ship the block\n      // (e.g. stale API). Non-admin users only see ``active`` — we\n      // still overwrite for correctness (admin-only tabs are hidden\n      // upstream, so writing them is harmless).\n      const cbs = data?.counts_by_status;\n      if (cbs && typeof cbs === \"object\") {\n        setCounts({\n          active: Number.isFinite(cbs.active) ? cbs.active : 0,\n          inactive: Number.isFinite(cbs.inactive) ? cbs.inactive : 0,\n          muted: isAdmin && Number.isFinite(cbs.muted) ? cbs.muted : null,\n          waitlist: isAdmin && Number.isFinite(cbs.waitlist)\n            ? cbs.waitlist : null,\n          all: isAdmin && Number.isFinite(cbs.all) ? cbs.all : null,\n        });\n      }\n      setSelected(new Set());\n    } catch (e) {\n      setToast({ tone: \"error\", message: e.message });\n      setRows([]);\n      setTotal(0);\n      setTotalPages(0);\n    }\n  })",[22252,22261],"[isAdmin, tab]",[23825,23830],"[cohortParam, navigate, searchParams, setSearchParams, tab]",[32699,32973],"[searchDeb, tag, scope, tab, missingCardOnly, missingEmail, missingPhone, missingAddress, portalStatusFilter, noPaymentFilter, neverLoggedIn, portalInvitedFilter, signedInFilter, includeDeleted, includeMerged, page, pageSize, city, selectedTags, sortBy, portalStatus, load]",[34625,34758],"[missingEmail, missingPhone, missingAddress, portalStatusFilter, noPaymentFilter, neverLoggedIn, portalInvitedFilter, signedInFilter, searchParams, setSearchParams]",[38489,38495],"[page, searchParams, setSearchParams]",[39402,39412],"[pageSize, searchParams, setSearchParams]",[39749,39751],"[loadCounts]",[8661,8693],"[form.crew_id, crews, techDirty, form.technician_id]",[4063,4067],[17971,17975],[12404,12408],[12754,12775],"[doc, doc.id, doc.terms]",[7430,7476],"[customerFilter, loadRows]",[27804,27810],"[date, load]",[28049,28057],"[crewId, load]",[36368,36385],"[load, rescheduleDraft]",[6222,6239],"[includeArchived, load]",[6465,6482],[10135,10164],"[row.body, row.subject, id, row]",[2010,2024],"[loadList, statusFilter]",[1493,1501],"[load, window]",[7337,7354],"[params, allowed, load]",[2451,2460],"[feature, loadTxns]",[1196,1198],"[loadHistory, url]",[2984,2998],"[load, showInactive]",[11236,11238],"[load]",[14682,14693],"[draft, draft.id]",[2081,2083],[5058,5101],"[dimension, rangeKey, customFrom, customTo, isAdmin, load]",[2587,2589],"[selectedId]",[3205,3219],"[selected, selected.id]",[30787,30800],"[jobId, jobs, techId]",[1679,1681],"[ctxUser]",[9271,9275],[9579,9594],"[audit, audit.status, load]",[1430,1460],"[current.status, current.id, current]",[1338,1355],"[auditId, filter, load]",[8020,8024],[10166,10170],[10818,10824],"[days, load]",[3330,3332],"[techId]",[1379,1387],"[filter, lo