\", \"image/webp\", \"image/heic\", \"image/heif\",\n]);\nexport const VIDEO_MIMES = new Set([\n  \"video/mp4\", \"video/quicktime\", \"video/webm\", \"video/x-m4v\",\n  \"video/avi\", \"video/x-msvideo\",\n]);\n\nexport class OfflineError extends Error {\n  constructor(msg: string) { super(msg); this.name = \"OfflineError\"; }\n}\n\n/**\n * K59.a · Feb-2026 — ``stringifyDetail`` lives in a sibling module\n * (``./serviceReportMediaErrors``) so it can be unit-tested without\n * pulling in AsyncStorage / SecureStore.  Re-exported here for\n * backward-compat with any consumer that expects it on this module.\n * See PHASE_K59_a_UPLOAD_ERROR_STRINGIFIER.md.\n */\nexport { stringifyDetail } from \"./serviceReportMediaErrors\";",{"messageId":"3371","data":"3372","fix":"3373","desc":"3374"},{"desc":"3375","fix":"3376"},{"kind":"3377","justification":"3357"},{"messageId":"3371","data":"3378","fix":"3379","desc":"3380"},{"messageId":"3371","data":"3381","fix":"3382","desc":"3383"},{"messageId":"3371","data":"3384","fix":"3385","desc":"3374"},{"messageId":"3371","data":"3386","fix":"3387","desc":"3388"},{"messageId":"3371","data":"3389","fix":"3390","desc":"3391"},{"messageId":"3371","data":"3392","fix":"3393","desc":"3394"},{"messageId":"3371","data":"3395","fix":"3396","desc":"3397"},{"desc":"3398","fix":"3399"},{"kind":"3377","justification":"3357"},{"kind":"3377","justification":"3357"},{"messageId":"3371","data":"3400","fix":"3401","desc":"3402"},{"desc":"3403","fix":"3404"},{"kind":"3377","justification":"3357"},{"desc":"3405","fix":"3406"},{"kind":"3377","justification":"3357"},{"desc":"3407","fix":"3408"},{"kind":"3377","justification":"3357"},{"messageId":"3371","data":"3409","fix":"3410","desc":"3411"},{"desc":"3412","fix":"3413"},{"kind":"3377","justification":"3357"},{"kind":"3377","justification":"3414"},{"kind":"3377","justification":"3414"},{"messageId":"3371","data":"3415","fix":"3416","desc":"3417"},{"messageId":"3371","data":"3418","fix":"3419","desc":"3417