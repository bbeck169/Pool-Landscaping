# Expo mobile environment. Copy to .env and fill in.

EXPO_PUBLIC_BACKEND_URL=https://your-app.preview.emergentagent.com
# Web app origin (customer portal / web-only pages). Optional — falls back to
# EXPO_PUBLIC_BACKEND_URL when unset (preview serves web + API on one host).
EXPO_PUBLIC_WEB_URL=
EXPO_PUBLIC_GOOGLE_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Expo tunnel/preview URL — set by Emergent runtime, do not commit
EXPO_TUNNEL_SUBDOMAIN=
EXPO_PACKAGER_HOSTNAME=
EXPO_PACKAGER_PROXY_URL=
EXPO_PUBLIC_ENV=preview

# Mapbox — Secret download token (sk.*). Build-time ONLY.
# Required scope: DOWNLOADS:READ
# The @rnmapbox/maps config plugin reads RNMAPBOX_MAPS_DOWNLOAD_TOKEN
# automatically from the environment at build time (no app.json property needed).
# For EAS cloud builds you MUST provision it as a secret:
#   eas secret:create --scope project --name RNMAPBOX_MAPS_DOWNLOAD_TOKEN --value <sk.token>
# NEVER ship in client bundle or commit to git.
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=sk.REPLACE_ME
