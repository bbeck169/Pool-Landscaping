# ─── Phase 52.1d · Feb-2026 — Walkie live-streaming TURN (metered.ca) ────
# All THREE vars MUST be present for TURN to activate. Any missing →
# STUN-only fallback (LAN + non-symmetric-NAT clients still work; users
# behind symmetric NAT will fail to connect through the internet without
# TURN).
#
# Free-tier signup: https://dashboard.metered.ca/ → Global TURN Server →
# copy the credentials block.
#
# Example:
# METERED_TURN_URLS=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:443?transport=tcp,turns:global.relay.metered.ca:443
# METERED_TURN_USERNAME=<from-dashboard>
# METERED_TURN_CREDENTIAL=<from-dashboard>
METERED_TURN_URLS=
METERED_TURN_USERNAME=
METERED_TURN_CREDENTIAL=

STRIPE_PUBLISHABLE_KEY_LIVE=pk_live_REPLACE_ME

# ─── Feb 2026 · Customer Merge Phase 3 — auto-merge cron flag ───────
# Daily 09:15 UTC sweep auto-merges high-confidence duplicate clusters
# (exact email OR exact phone). Low-confidence groups (name+address,
# fuzzy name) are NEVER auto-merged — they land in the admin manual
# review queue exposed at ``GET /api/customers/merge-candidates?
# confidence=low``.
#
# Values: ``true`` (default) enables the daily cron. Any of
# ``0``/``false``/``no``/``off`` disables it — the boot-time cleanup
# migration + super_admin "Force sweep now" endpoint still run.
AUTO_MERGE_ENABLED=true