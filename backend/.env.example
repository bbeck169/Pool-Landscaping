# Backend environment variables. Copy to .env and fill in real values.

# ─── Core ──────────────────────────────────────────────────────────────
MONGO_URL=mongodb://localhost:27017
DB_NAME=poolscape
CORS_ORIGINS=*
JWT_SECRET=change-me
JWT_TTL_MINUTES=1440

# ─── Integrations (see /settings/integrations for status in the UI) ─────
# LLMs (Emergent Universal Key — powers Claude/OpenAI/Gemini + image gen)
EMERGENT_LLM_KEY=

# Optional / unused. The OpenAI SDK fallback branch in
# ``services/llm_provider.py`` is a no-op stub unless this is set; the
# app runs on Emergent only. Leave blank to disable.
OPENAI_API_KEY=

# Email delivery (Resend)
RESEND_API_KEY=
EMAIL_FROM=cs@plofv.com
# Slice N (Feb 2026): production sender identity + webhook receiver.
# When RESEND_API_KEY is unset the adapter runs in graceful "mocked"
# mode: nothing leaves the box, calls still return a delivery row.
RESEND_FROM_ADDRESS=cs@plofv.com
RESEND_FROM_NAME=Pool & Landscaping of Vistancia
RESEND_FROM=cs@plofv.com
RESEND_WEBHOOK_SECRET=

# Payments (Stripe test key)
# NOTE — the runtime reads STRIPE_SECRET_KEY (see routers/payments.py,
# services/stripe_client.py, routers/customer_portal.py). ``STRIPE_API_KEY``
# below is kept for backward-compat with older tooling that greps for
# ``STRIPE_API_KEY``; when both are set, STRIPE_SECRET_KEY wins.
STRIPE_SECRET_KEY=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Phase 4B · Live-payments metadata (never contains secret values):
#   STRIPE_MODE       — 'live' | 'test'; must match the ``sk_*`` prefix.
#   STRIPE_ACCOUNT_ID — connected-account id (acct_...); masked in logs
#                       + the /api/dev/stripe-config-check response.
STRIPE_MODE=
STRIPE_ACCOUNT_ID=

# SMS delivery (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Slice S · API-Key auth (preferred — supports rotation without Auth Token exposure)
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_STATUS_CALLBACK_URL=

# Google — Places autocomplete, Geocoding, Maps tiles, Directions
GOOGLE_API_KEY=

# Google Business Profile OAuth
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=

# Zillow via OpenWeb Ninja
OPENWEB_NINJA_API_KEY=

# WordPress publishing (SEO Studio)
WORDPRESS_URL=
WORDPRESS_USER=
WORDPRESS_APP_PASSWORD=

# ─── Reviews Phase 3 · External review scraping (Feb 2026) ─────────────
# Google Business Profile — reuses the OAuth flow in routers/gbp.py.
# Set to true only AFTER the tenant has completed GBP OAuth.
GOOGLE_GBP_INTEGRATION_ENABLED=false
# Facebook Pages — gated until the Page Access Token exchange ships.
FACEBOOK_INTEGRATION_ENABLED=false
# Yelp Fusion — https://fusion.yelp.com/ · Fusion returns 3 excerpts
# per business max (not full text), so scraped Yelp reviews are
# stamped ``partial_content=true``.
YELP_API_KEY=

# Weather (WeatherAPI.com — used by tech dashboard weather widget)
WEATHERAPI_KEY=

# Phase 6 · RingCentral (placeholders only; real values live in .env)
RC_CLIENT_ID=
RC_CLIENT_SECRET=
RC_JWT=
RC_SERVER_URL=
RC_WEBHOOK_URL=
RC_VERIFICATION_TOKEN=
RC_MODE=
