# ═══════════════════════════════════════════════════════════════════════
# PRODUCTION .env template · Pool & Landscaping of Vistancia
# ═══════════════════════════════════════════════════════════════════════
#
# ⚠️  DO NOT `cp .env.example .env` on production.
# The preview `.env.example` seeds `APP_ENV=preview` + `SHOW_DEMO_LOGINS=true`
# + `STRIPE_MODE=test` + `CORS_ORIGINS=*` which caused the Feb-2026 demo-
# tiles leak on `app.plofv.com`. Use THIS file as the base for a prod
# deploy — every value marked `TODO: real value from ops` MUST be replaced
# with the actual secret before the container boots.
#
# Companion docs:
#   /app/memory/promote_to_prod_checklist.md   ← ordered promotion runbook
#   /app/memory/env_vars.md                    ← per-var purpose + surfaces
#
# ═══════════════════════════════════════════════════════════════════════

# ── Core runtime ──────────────────────────────────────────────────────
MONGO_URL=                                # TODO: real value from ops (prod cluster URI)
DB_NAME=poolscape                         # confirm matches provisioned DB
CORS_ORIGINS=https://app.plofv.com,https://www.plofv.com   # tighten further if there are more front-doors
JWT_SECRET=                               # TODO: real value from ops (rotate from any preview value)
JWT_TTL_MINUTES=1440
APP_ENV=production
APP_BASE_URL=https://app.plofv.com
SHOW_DEMO_LOGINS=false

# ── LLMs (Emergent universal key) ─────────────────────────────────────
EMERGENT_LLM_KEY=                         # TODO: real value from ops
OPENAI_API_KEY=                           # leave blank unless a dedicated OpenAI key is required

# ── Transactional email (Resend) ──────────────────────────────────────
RESEND_API_KEY=                           # TODO: real value from ops
EMAIL_FROM=cs@plofv.com
RESEND_FROM_ADDRESS=cs@plofv.com
RESEND_FROM_NAME=Pool & Landscaping of Vistancia
RESEND_FROM=cs@plofv.com
RESEND_WEBHOOK_SECRET=                    # TODO: real value from ops

# ── Google / Maps / GBP ───────────────────────────────────────────────
GOOGLE_API_KEY=                           # TODO: real value from ops (backend-side, if used)
GBP_CLIENT_ID=                            # TODO: real value from ops (Google Business Profile OAuth)
GBP_CLIENT_SECRET=                        # TODO: real value from ops
GOOGLE_GBP_INTEGRATION_ENABLED=true       # flip to true in prod when GBP is provisioned

# ── OpenWeb Ninja (Zillow / property data) ────────────────────────────
OPENWEB_NINJA_API_KEY=                    # TODO: real value from ops

# ── WordPress publishing ──────────────────────────────────────────────
WORDPRESS_URL=
WORDPRESS_USER=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=
WORDPRESS_AUTO_PUBLISH=false

# ── Facebook / Yelp / Weather ─────────────────────────────────────────
# Feb-2026 · P39a — Weather migrated from WeatherAPI.com to NWS
# (api.weather.gov). NWS is keyless; ``WEATHERAPI_KEY`` was removed.
FACEBOOK_INTEGRATION_ENABLED=false
YELP_API_KEY=

# ── RingCentral (voice + SMS) ─────────────────────────────────────────
RC_CLIENT_ID=                             # TODO: real value from ops
RC_CLIENT_SECRET=                         # TODO: real value from ops
RC_JWT=                                   # TODO: real value from ops
RC_SERVER_URL=https://platform.ringcentral.com
RC_WEBHOOK_URL=
RC_VERIFICATION_TOKEN=
RC_MODE=live

# ── Supercool / MCP ───────────────────────────────────────────────────
SUPERCOOL_MCP_URL=https://mcp.supercool.com/mcp
MCP_TOKEN_ENCRYPTION_KEY=                 # TODO: real value from ops (32-byte b64)
SUPERCOOL_DAILY_IMAGE_LIMIT=100

# ── Comms whitelist (preview safety) ──────────────────────────────────
# EMPTY on prod → whitelist is bypassed entirely when APP_ENV=production
# (see services/comms_env_guard.py). Kept declared here so ops sees the
# intent even though the values are ignored in prod mode.
COMMS_TEST_ALLOWLIST_EMAILS=
COMMS_TEST_ALLOWLIST_PHONES=

# ── Payments (Stripe live) ────────────────────────────────────────────
PAYMENT_PROVIDER=stripe
STRIPE_MODE=live
STRIPE_SECRET_KEY_TEST=                   # leave blank in prod
STRIPE_SECRET_KEY_LIVE=                   # TODO: real value from ops (sk_live_…)
STRIPE_WEBHOOK_SECRET_TEST=               # leave blank in prod
STRIPE_WEBHOOK_SECRET_LIVE=               # TODO: real value from ops (whsec_…)
STRIPE_PUBLISHABLE_KEY_TEST=              # leave blank in prod
STRIPE_PUBLISHABLE_KEY_LIVE=              # TODO: real value from ops (pk_live_…)
PAYMENTS_TEST_ALLOWLIST_CUSTOMERS=

# ── Lumino (alt payments) ─────────────────────────────────────────────
LUMINO_API_URL=
LUMINO_API_TOKEN=                         # TODO: real value from ops (sk_live_…)
LUMINO_WEBHOOK_SECRET=                    # TODO: real value from ops
LUMINO_RETURN_URL=https://app.plofv.com/portal/payment-method/return
LUMINO_ZAPIER_SHARED_SECRET=              # TODO: real value from ops

# ── Zapier ────────────────────────────────────────────────────────────
ZAPIER_INVOICE_LINK_WEBHOOK_URL=          # TODO: real value from ops

# ── Mapbox (dispatch map) ─────────────────────────────────────────────
MAPBOX_ACCESS_TOKEN=                      # TODO: real value from ops (pk.eyJ… — safe to expose)

# ── Walkie-Talkie WebRTC (metered.ca TURN) ────────────────────────────
METERED_TURN_URLS=
METERED_TURN_USERNAME=

# ── Cloudflare Turnstile (optional) ───────────────────────────────────
TURNSTILE_SECRET=

# ═══════════════════════════════════════════════════════════════════════
# END OF TEMPLATE — verify no value still reads `TODO: real value from ops`
# before running `docker compose up` / triggering the Emergent deploy.
# ═══════════════════════════════════════════════════════════════════════
